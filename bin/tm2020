#!/usr/bin/env bash
# Run Ubisoft Connect for Trackmania 2020 in its own Wine prefix.
set -euo pipefail

PROJECT="$(cd "$(dirname "$0")/.." && pwd)"
readonly PROJECT
VERSION="$(cat "${PROJECT}/VERSION")"
readonly VERSION

: "${TM2020_ROOT:=${HOME}/Games/TM2020}"
: "${TM2020_SUPPORT:=${HOME}/Library/Application Support/Trackmania2020}"
: "${TM2020_CACHE:=${HOME}/Library/Caches/Trackmania2020}"
: "${TM2020_RUNTIME:=${TM2020_SUPPORT}/runtime/${VERSION}}"
if test -w /Applications; then
  : "${TM2020_APP:=/Applications/Trackmania 2020.app}"
else
  : "${TM2020_APP:=${HOME}/Applications/Trackmania 2020.app}"
fi

readonly DXVK_CONF="${PROJECT}/config/dxvk.conf"

export WINEPREFIX="${TM2020_ROOT}/prefix"
export WINEDEBUG="${WINEDEBUG:-fixme-all}"
# Nothing here uses .NET or Gecko. Wine would offer to download them each time a new
# runtime updates the prefix.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=d}"
export DXVK_CONFIG_FILE="${DXVK_CONFIG_FILE:-Z:${DXVK_CONF//\//\\}}"
export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-warn}"
export DXVK_LOG_PATH="${DXVK_LOG_PATH:-none}"
export DXVK_STATE_CACHE_PATH="${DXVK_STATE_CACHE_PATH:-Z:${TM2020_ROOT//\//\\}\\dxvk-cache}"

readonly INSTALLER_URL="https://static3.cdn.ubi.com/orbit/launcher_installer/UbisoftConnectInstaller.exe"
readonly CDN_URL="${TM2020_CDN_URL:-http://uplaypc-s-ubisoft.cdn.ubi.com/}"
readonly INSTALLER="${TM2020_CACHE}/UbisoftConnectInstaller.exe"
readonly CONNECT_EXE='C:\Program Files (x86)\Ubisoft\Ubisoft Game Launcher\UbisoftConnect.exe'
readonly CONNECT_UNIX="${WINEPREFIX}/drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/UbisoftConnect.exe"
readonly LOGS="${TM2020_ROOT}/logs"
LOCAL_STATE="${WINEPREFIX}/drive_c/users/$(id -un)/AppData/Local/Ubisoft Game Launcher/cache/http2/Local State"
readonly LOCAL_STATE
readonly WINE="${TM2020_RUNTIME}/bin/wine"
readonly DXVK_DLLS="${TM2020_RUNTIME}/lib/dxvk"
readonly CONNECT_IDLE="${TM2020_RUNTIME}/libexec/connect-idle.exe"
readonly WINDOWS_DIR="${WINEPREFIX}/drive_c/windows"
readonly APP_ID=local.trackmania2020-macos.connect

fail() {
  echo "$*" >&2
  exit 1
}

require_runtime() {
  test -x "$WINE" && return
  fail "No runtime in ${TM2020_RUNTIME}. Install it with install.sh, or build it with: make build"
}

# Wine keeps one server for each prefix, with its socket in a folder named after the
# prefix's device and inode.
wine_is_running() {
  local device inode
  test -d "$WINEPREFIX" || return 1
  read -r device inode < <(stat -f '%d %i' "$WINEPREFIX")
  test -S "$(printf '/tmp/.wine-%s/server-%x-%x/socket' "$(id -u)" "$device" "$inode")" &&
    pgrep -x wineserver >/dev/null
}

# Most of what Wine prints looks like an error and isn't, so it goes to a log.
logged() {
  "$@" >>"${LOGS}/install.log" 2>&1 && return
  echo "This failed: $*" >&2
  echo "Wine's output is in ${LOGS}/install.log" >&2
  return 1
}

install_connect() {
  mkdir -p "$TM2020_CACHE" "$LOGS"
  if ! test -f "$INSTALLER"; then
    echo "Downloading Ubisoft Connect's installer"
    curl --fail --location --retry 3 --progress-bar --output "${INSTALLER}.partial" "$INSTALLER_URL"
    mv "${INSTALLER}.partial" "$INSTALLER"
  fi
  echo 'Installing Ubisoft Connect. This takes a few minutes.'
  if ! test -d "$WINEPREFIX"; then
    logged "$WINE" wineboot -i
    logged "${TM2020_RUNTIME}/bin/wineserver" -w
    # Connect's window needs wined3d's OpenGL backend.
    logged "$WINE" reg add 'HKCU\Software\Wine\Direct3D' /v renderer /t REG_SZ /d gl /f
    # Crashes go to the log as backtraces, not to a dialog.
    logged "$WINE" reg add 'HKCU\Software\Wine\WineDbg' /v ShowCrashDialog /t REG_DWORD /d 0 /f
  fi
  logged "$WINE" start /wait /unix "$INSTALLER" /S
}

# Chromium's GPU process can't reach upc.exe's window through OpenGL here, since
# winemac has no cross-process GL. Software compositing goes through GDI, which
# patches/wine/0002 forwards. Connect ignores Chromium switches, so use the pref.
# This is JavaScript for osascript, because python3 needs Apple's command line tools.
use_software_compositing() {
  mkdir -p "$(dirname "$LOCAL_STATE")"
  /usr/bin/osascript -l JavaScript - "$LOCAL_STATE" >/dev/null <<'JS'
ObjC.import('Foundation')
function run(argv) {
  const text = $.NSString.stringWithContentsOfFileEncodingError(argv[0], $.NSUTF8StringEncoding, null)
  const state = text.isNil() ? {} : JSON.parse(text.js)
  if (JSON.stringify(state.hardware_acceleration_mode) === '{"enabled":false}')
    return
  state.hardware_acceleration_mode = {enabled: false}
  if (!$(JSON.stringify(state)).writeToFileAtomicallyEncodingError(argv[0], true, $.NSUTF8StringEncoding, null))
    throw new Error('Could not write ' + argv[0])
}
JS
}

# Wine's D3D11 stops at feature level 9_3 on this GPU, so the programs that need
# more get DXVK, one executable at a time. Everything else keeps Wine's own.
use_dxvk() {
  local exe="$1" bits="$2" system="$3" dll
  for dll in d3d11 dxgi; do
    cmp -s "${DXVK_DLLS}/${bits}/${dll}.dll" "${WINDOWS_DIR}/${system}/${dll}.dll" ||
      cp -f "${DXVK_DLLS}/${bits}/${dll}.dll" "${WINDOWS_DIR}/${system}/${dll}.dll"
  done
  if ! grep -qF "AppDefaults\\\\${exe}\\\\DllOverrides" "${WINEPREFIX}/user.reg"; then
    for dll in d3d11 dxgi; do
      "$WINE" reg add "HKCU\\Software\\Wine\\AppDefaults\\${exe}\\DllOverrides" /v "$dll" /t REG_SZ /d native /f >/dev/null
    done
  fi
}

# The CDN refuses a bare request either way, so the status code says nothing.
# What matters is who answered: a firewall's page or the CDN itself.
check_download() {
  local response
  response="$(curl --silent --include --max-time 10 "$CDN_URL" || true)"
  if test -z "$response"; then
    echo "NO ANSWER: Ubisoft's download server could not be reached from this network."
    return 1
  elif grep -qiE 'Application Control Violation|Policy Violation' <<<"$response"; then
    echo "BLOCKED: a firewall on this network answered instead of Ubisoft's download server."
    return 1
  elif grep -qiE '^server: *akamai' <<<"$response"; then
    echo "OPEN: Ubisoft's download server answered directly. Try Install in Connect."
  else
    echo "UNKNOWN: something else answered, possibly another network's filter."
    grep -iE '^server:' <<<"$response" || true
    sed -nE 's/.*<title>(.*)<\/title>.*/title: \1/Ip' <<<"$response" | head -1
    return 1
  fi
}

prepare_connect() {
  test -f "$CONNECT_UNIX" || install_connect
  use_software_compositing
  # patches/wine/0003 moves WebGL in Connect's GPU process to D3D11, which
  # DXVK answers for with the identity in config/dxvk.conf.
  use_dxvk UplayWebCore.exe x32 syswow64
  use_dxvk Trackmania.exe x64 system32
  mkdir -p "$LOGS" "${TM2020_ROOT}/dxvk-cache"
}

start_helper() {
  # Older runtimes don't have this. See tools/connect-idle.c.
  if test -f "$CONNECT_IDLE"; then
    "$WINE" "$CONNECT_IDLE" >/dev/null 2>&1 &
  fi
}

# Connect records where it installed the game.
game_dir() {
  sed -n '/^\[Software\\\\Wow6432Node\\\\Ubisoft\\\\Launcher\\\\Installs\\\\5595\]/,/^$/s/^"InstallDir"="\(.*\)"$/\1/p' \
    "${WINEPREFIX}/system.reg" 2>/dev/null
}

# Openplanet's installer only installs next to Trackmania.exe, so it needs the game's folder.
install_openplanet() {
  local dir
  dir="$(game_dir)"
  test -n "$dir" || fail 'Install Trackmania in Ubisoft Connect first.'
  ! wine_is_running || fail 'Quit Trackmania and Ubisoft Connect first, then run this again.'
  mkdir -p "$LOGS"
  dir="${dir%/}"
  echo "Installing Openplanet into ${dir}"
  logged "$WINE" "$1" /S "/D=${dir//\//\\}"
  echo 'Done. In the game, press F3 to open Openplanet. On most Mac keyboards that is fn and F3.'
}

# Gives the app the game's own icon, which stays in the game. See tools/app-icon.js.
add_app_icon() {
  local dir work name size status
  dir="$(game_dir)"
  case "$dir" in
    [Cc]:/*) dir="${WINEPREFIX}/drive_c/${dir#?:/}" ;;
    *) return 1 ;;
  esac
  dir="${dir%/}"
  work="$(mktemp -d)"
  mkdir "${work}/AppIcon.iconset"
  # Each step runs only if the one before it worked. The app keeps working without an icon.
  osascript -l JavaScript "${PROJECT}/tools/app-icon.js" "${dir}/Trackmania.exe" "${work}/icon.png" 2>/dev/null &&
    for name in 16x16:16 16x16@2x:32 32x32:32 32x32@2x:64 128x128:128 128x128@2x:256 256x256:256; do
      size="${name#*:}"
      sips -z "$size" "$size" "${work}/icon.png" --out "${work}/AppIcon.iconset/icon_${name%:*}.png" >/dev/null
    done &&
    iconutil -c icns "${work}/AppIcon.iconset" -o "${TM2020_APP}/Contents/Resources/AppIcon.icns"
  status=$?
  rm -rf "$work"
  return "$status"
}

# The game is usually installed after the app is made, so the app gets its icon on a later start.
refresh_app_icon() {
  test ! -f "${TM2020_APP}/Contents/Resources/AppIcon.icns" || return 0
  test "$(plutil -extract CFBundleIdentifier raw -o - "${TM2020_APP}/Contents/Info.plist" 2>/dev/null)" = "$APP_ID" ||
    return 0
  if add_app_icon; then touch "$TM2020_APP"; fi
}

# The app is a small script that runs this file's start command, with the folders this
# installation uses written into it.
write_app() {
  local contents="${TM2020_APP}/Contents" found
  if test -e "$TM2020_APP"; then
    found="$(plutil -extract CFBundleIdentifier raw -o - "${contents}/Info.plist" 2>/dev/null || true)"
    test "$found" = "$APP_ID" || fail "${TM2020_APP} is another app. Move it away, or set TM2020_APP to another path."
  fi
  mkdir -p "${contents}/MacOS" "${contents}/Resources"
  cat >"${contents}/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>tm2020</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleIdentifier</key><string>${APP_ID}</string>
  <key>CFBundleName</key><string>Trackmania 2020</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>${VERSION}</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.racing-games</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <!-- Connect and the game have their own icons in the Dock, so this one stays out of it. -->
  <key>LSUIElement</key><true/>
</dict>
</plist>
EOF
  {
    echo '#!/bin/bash'
    echo '# Starts Ubisoft Connect for Trackmania 2020. Written by bin/tm2020 app.'
    printf 'export TM2020_ROOT=%q TM2020_SUPPORT=%q TM2020_CACHE=%q TM2020_RUNTIME=%q TM2020_APP=%q\n' \
      "$TM2020_ROOT" "$TM2020_SUPPORT" "$TM2020_CACHE" "$TM2020_RUNTIME" "$TM2020_APP"
    printf 'tm2020=%q\n' "${PROJECT}/bin/tm2020"
    printf 'log=%q\n' "${LOGS}/start.log"
    cat <<'SH'
mkdir -p "$(dirname "$log")"
if ! "$tm2020" start >"$log" 2>&1; then
  osascript -e 'on run argv' \
    -e 'display alert "Trackmania 2020 could not start" message ((item 1 of argv) & return & return & "The log is " & (item 2 of argv)) as critical' \
    -e 'end run' "$(tail -n 1 "$log")" "$log" >/dev/null
fi
SH
  } >"${contents}/MacOS/tm2020.partial"
  chmod +x "${contents}/MacOS/tm2020.partial"
  mv -f "${contents}/MacOS/tm2020.partial" "${contents}/MacOS/tm2020"
  add_app_icon || true
  # Finder and Launchpad notice a changed app sooner when its folder is touched.
  touch "$TM2020_APP"
  echo "The app is ${TM2020_APP}"
}

uninstall() {
  local answer server app=''
  if test "$(plutil -extract CFBundleIdentifier raw -o - "${TM2020_APP}/Contents/Info.plist" 2>/dev/null)" = "$APP_ID"; then
    app="$TM2020_APP"
  fi
  echo 'This removes Ubisoft Connect, Trackmania and everything else this project installed:'
  printf '  %s\n' "${TM2020_ROOT}/prefix" "${TM2020_ROOT}/dxvk-cache" "${TM2020_ROOT}/logs" \
    "$TM2020_SUPPORT" "$TM2020_CACHE" ${app:+"$app"}
  echo 'Your game settings, maps and replays in ~/Documents/Trackmania stay.'
  read -r -p 'Type yes to remove all of this: ' answer || true
  test "$answer" = yes || fail 'Nothing was removed.'
  for server in "${TM2020_SUPPORT}"/runtime/*/bin/wineserver "${TM2020_RUNTIME}/bin/wineserver"; do
    if test -x "$server"; then "$server" -k 2>/dev/null || true; fi
  done
  if test -n "$app"; then rm -rf "$app"; fi
  # Removing a folder never follows the prefix's links to your own folders.
  rm -rf "${TM2020_ROOT}/prefix" "${TM2020_ROOT}/dxvk-cache" "${TM2020_ROOT}/logs" \
    "${TM2020_SUPPORT}/runtime" "${TM2020_SUPPORT}/launcher" "$TM2020_CACHE"
  rmdir "$TM2020_ROOT" "$TM2020_SUPPORT" 2>/dev/null || true
  echo 'Removed.'
}

usage() {
  cat >&2 <<EOF
usage: $(basename "$0") <command>

  start            Start Ubisoft Connect in the background, as the app does
  connect          Start Connect and wait until it closes
  stop             Stop Connect and the game
  openplanet FILE  Install Openplanet with its installer, while the game is closed
  check-download   Tell whether this network lets Connect download from Ubisoft
  diag             Start Connect, and record frame rate, CPU and GPU use while you play
  report           Show what the last diag session recorded
  prepare          Install Connect if it is missing, and set up the prefix
  install          Run Connect's installer again
  app              Make the Trackmania 2020 app, which runs start
  uninstall        Remove Connect, the game and everything else this project installed
EOF
  exit 2
}

case "${1:-}" in
  start)
    require_runtime
    prepare_connect
    start_helper
    refresh_app_icon
    # Connect keeps running after this script and the app are done.
    "$WINE" "$CONNECT_EXE" </dev/null >"${LOGS}/connect.log" 2>&1 &
    ;;
  connect)
    require_runtime
    prepare_connect
    start_helper
    exec "$WINE" "$CONNECT_EXE" >"${LOGS}/connect.log" 2>&1
    ;;
  stop)
    require_runtime
    "${TM2020_RUNTIME}/bin/wineserver" -k
    ;;
  openplanet)
    test -f "${2:-}" || usage
    require_runtime
    install_openplanet "$2"
    ;;
  check-download)
    check_download
    ;;
  diag)
    require_runtime
    prepare_connect
    start_helper
    export WINEDEBUG="fixme-all,+timestamp,+pid,+fps${TM2020_TRACE:+,${TM2020_TRACE}}"
    python3 -I "${PROJECT}/tools/session.py" monitor "${LOGS}/session.tsv" &
    exec "$WINE" "$CONNECT_EXE" >"${LOGS}/connect.log" 2>&1
    ;;
  report)
    python3 -I "${PROJECT}/tools/session.py" report "${LOGS}/session.tsv" "${LOGS}/connect.log"
    ;;
  prepare)
    require_runtime
    # A running Connect keeps its own runtime, and the game has the DXVK files open.
    ! wine_is_running || fail 'Quit Trackmania and Ubisoft Connect first, then run this again.'
    prepare_connect
    ;;
  install)
    require_runtime
    install_connect
    ;;
  app)
    write_app
    ;;
  uninstall)
    uninstall
    ;;
  *)
    usage
    ;;
esac
