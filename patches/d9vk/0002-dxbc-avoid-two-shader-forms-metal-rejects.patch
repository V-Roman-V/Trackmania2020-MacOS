+      const uint32_t typeId = getScalarTypeId(DxbcScalarType::Uint32);
+      const uint32_t index  = m_module.constu32(0);
+      const uint32_t ptrId  = m_module.opAccessChain(
+        m_module.defPointerType(typeId, spv::StorageClassInput),
+        m_ps.builtinSampleMaskIn, 1, &index);
+      m_module.opStore(m_ps.sampleMaskIn, m_module.opLoad(typeId, ptrId));
+    }
