Subject: dxgi: Copy the whole adapter description.

The length was in characters where memcpy wants bytes, so the name came out cut
in half. ANGLE puts this name in the WebGL renderer string.

--- a/src/dxgi/dxgi_adapter.cpp
+++ b/src/dxgi/dxgi_adapter.cpp
@@ -269,7 +269,8 @@ namespace dxvk {
     // Convert device name
     std::memset(pDesc->Description, 0, sizeof(pDesc->Description));
     std::wstring descriptionWStr = str::tows(description);
-    std::memcpy(pDesc->Description, descriptionWStr.c_str(), descriptionWStr.size());
+    std::memcpy(pDesc->Description, descriptionWStr.c_str(),
+      std::min(descriptionWStr.size() * sizeof(WCHAR), sizeof(pDesc->Description) - sizeof(WCHAR)));
     
     // Get amount of video memory
     // based on the Vulkan heaps
