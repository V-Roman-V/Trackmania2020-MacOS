--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -56,6 +56,7 @@
 #include <time.h>
 #ifdef __APPLE__
 # include <mach/mach_time.h>
+# include <sys/sysctl.h>
 #endif
 #ifdef HAVE_KQUEUE
 # include <sys/event.h>
@@ -2622,7 +2623,46 @@
 
 /******************************************************************************
  *              RtlGetSystemTimePrecise (NTDLL.@)
+ */
+/***********************************************************************
+ *           tsc_counter_bias
+ *
+ * Under Rosetta the TSC counts nanoseconds and reading it stays in translated code,
+ * while NtQueryPerformanceCounter has to switch GSBASE twice, which takes about 400 ns.
+ * Return what to add to the TSC to get the nanoseconds that monotonic_counter() uses.
  */
+NTSTATUS tsc_counter_bias( void *args )
+{
+#if defined(__APPLE__) && defined(__x86_64__)
+    LONGLONG *bias = args;
+    mach_timebase_info_data_t timebase;
+    ULONGLONG tsc, start, elapsed;
+    size_t size = sizeof(int);
+    int translated = 0, i;
+
+    if (getenv( "WINE_QPC_NO_TSC" )) return STATUS_NOT_SUPPORTED;
+    if (sysctlbyname( "sysctl.proc_translated", &translated, &size, NULL, 0 ) || !translated)
+        return STATUS_NOT_SUPPORTED;
+    mach_timebase_info( &timebase );
+    if (timebase.numer != timebase.denom) return STATUS_NOT_SUPPORTED;
+
+    /* being preempted here would look like a wrong rate, so allow for that */
+    for (i = 0; i < 3; i++)
+    {
+        tsc = __builtin_ia32_rdtsc();
+        start = mach_absolute_time();
+        do elapsed = mach_absolute_time() - start; while (elapsed < 20000);
+        tsc = __builtin_ia32_rdtsc() - tsc;
+        if (tsc >= elapsed - elapsed / 100 && tsc <= elapsed + elapsed / 100)
+        {
+            *bias = mach_continuous_time() - __builtin_ia32_rdtsc();
+            return STATUS_SUCCESS;
+        }
+    }
+#endif
+    return STATUS_NOT_SUPPORTED;
+}
+
 NTSTATUS system_time_precise( void *args )
 {
     LONGLONG *ret = args;
