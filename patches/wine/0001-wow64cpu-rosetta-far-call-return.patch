Subject: wow64cpu: Use far call and return for mode switches under Rosetta.

Under Rosetta a far jmp between 32-bit and 64-bit code can leave the translator
in 32-bit mode, so syscall_32to64 runs as 32-bit code and faults on its first
rip-relative load. Chromium renderers hit this reliably (Ubisoft Connect's
UplayWebCore), with 00005ECD as the fault address in this build.

Detect Rosetta from the processor brand string and enter 64-bit code with lcall
through a small landing pad, returning to 32-bit code with lretq. Other hosts
keep the far jmp path. Porting Kit's Wine 11.0 build uses the same sequence.

--- a/dlls/wow64cpu/cpu.c
+++ b/dlls/wow64cpu/cpu.c
@@ -19,6 +19,7 @@
  */
 
 #include <stdarg.h>
+#include <string.h>
 
 #include "ntstatus.h"
 #include "windef.h"
@@ -39,10 +40,29 @@ struct thunk_32to64
     DWORD addr;
     WORD  cs;
 };
+/* Rosetta can stay in 32-bit mode after a far jmp, and then decodes the 64-bit
+ * entry points as 32-bit code. It tracks far call/return pairs correctly. */
+struct rosetta_thunk_32to64
+{
+    BYTE    lcall;      /* call far, absolute indirect */
+    BYTE    modrm;      /* address=disp32, opcode=3 */
+    DWORD   op;
+    DWORD   addr;       /* the 64-bit code below */
+    WORD    cs;
+    BYTE    add_esp[3]; /* drop the far return address */
+    BYTE    jmp[2];     /* jump near, absolute indirect, rip-relative */
+    DWORD   disp;
+    ULONG64 target;
+};
+union thunk
+{
+    struct thunk_32to64 far_jmp;
+    struct rosetta_thunk_32to64 far_call;
+};
 struct thunk_opcodes
 {
-    struct thunk_32to64 syscall_thunk;
-    struct thunk_32to64 unix_thunk;
+    union thunk syscall_thunk;
+    union thunk unix_thunk;
 };
 #pragma pack(pop)
 
@@ -54,6 +74,7 @@ UINT ss32_sel = 0;
 static USHORT cs64_sel;
 static USHORT ds64_sel;
 static USHORT fs32_sel;
+static BOOL use_far_call;
 
 void **__wine_unix_call_dispatcher = NULL;
 
@@ -210,7 +231,15 @@ __ASM_GLOBAL_FUNC( syscall_32to64,
                    "movl %edx,4(%rsp)\n\t"
                    "movl 0xc4(%r13),%r14d\n\t"  /* context->Esp */
                    "xchgq %r14,%rsp\n\t"
+                   "cmpl $0,use_far_call(%rip)\n\t"
+                   "jne 1f\n\t"
                    "ljmp *(%r14)\n"
+                   "1:\tsubq $0x10,%rsp\n\t"
+                   "movl 4(%r14),%edx\n\t"
+                   "movq %rdx,8(%rsp)\n\t"
+                   "movl (%r14),%edx\n\t"
+                   "movq %rdx,(%rsp)\n\t"
+                   "lretq\n"
                    ".Lsyscall_32to64_return:\n\t"
                    "movq %rsp,%r14\n\t"
                    "movl 0xa8(%r13),%edx\n\t"   /* context->Edx */
@@ -270,7 +299,15 @@ __ASM_GLOBAL_FUNC( unix_call_32to64,
                    "movl %edx,4(%rsp)\n\t"
                    "movl 0xc4(%r13),%r14d\n\t"  /* context->Esp */
                    "xchgq %r14,%rsp\n\t"
-                   "ljmp *(%r14)" )
+                   "cmpl $0,use_far_call(%rip)\n\t"
+                   "jne 1f\n\t"
+                   "ljmp *(%r14)\n"
+                   "1:\tsubq $0x10,%rsp\n\t"
+                   "movl 4(%r14),%edx\n\t"
+                   "movq %rdx,8(%rsp)\n\t"
+                   "movl (%r14),%edx\n\t"
+                   "movq %rdx,(%rsp)\n\t"
+                   "lretq" )
 
 
 /**********************************************************************
@@ -301,6 +338,41 @@ __ASM_GLOBAL_FUNC( BTCpuSimulate,
 /**********************************************************************
  *           BTCpuProcessInit  (wow64cpu.@)
  */
+static BOOL is_rosetta(void)
+{
+    char brand[0x41] = {0};
+
+    return !NtQuerySystemInformation( SystemProcessorBrandString, brand, sizeof(brand) - 1, NULL )
+            && strstr( brand, "VirtualApple" );
+}
+
+static void init_thunk( union thunk *thunk, void *target )
+{
+    if (use_far_call)
+    {
+        thunk->far_call.lcall = 0xff;
+        thunk->far_call.modrm = 0x1d;
+        thunk->far_call.op    = PtrToUlong( &thunk->far_call.addr );
+        thunk->far_call.addr  = PtrToUlong( thunk->far_call.add_esp );
+        thunk->far_call.cs    = cs64_sel;
+        thunk->far_call.add_esp[0] = 0x83;  /* addl $8,%esp */
+        thunk->far_call.add_esp[1] = 0xc4;
+        thunk->far_call.add_esp[2] = 0x08;
+        thunk->far_call.jmp[0] = 0xff;      /* jmpq *0(%rip) */
+        thunk->far_call.jmp[1] = 0x25;
+        thunk->far_call.disp   = 0;
+        thunk->far_call.target = (ULONG_PTR)target;
+    }
+    else
+    {
+        thunk->far_jmp.ljmp  = 0xff;
+        thunk->far_jmp.modrm = 0x2d;
+        thunk->far_jmp.op    = PtrToUlong( &thunk->far_jmp.addr );
+        thunk->far_jmp.addr  = PtrToUlong( target );
+        thunk->far_jmp.cs    = cs64_sel;
+    }
+}
+
 NTSTATUS WINAPI BTCpuProcessInit(void)
 {
     struct thunk_opcodes *thunk = (struct thunk_opcodes *)code_buffer;
@@ -335,17 +407,9 @@ NTSTATUS WINAPI BTCpuProcessInit(void)
     cs32_sel = context_i386.SegCs;
     ss32_sel = context_i386.SegSs;
 
-    thunk->syscall_thunk.ljmp  = 0xff;
-    thunk->syscall_thunk.modrm = 0x2d;
-    thunk->syscall_thunk.op    = PtrToUlong( &thunk->syscall_thunk.addr );
-    thunk->syscall_thunk.addr  = PtrToUlong( syscall_32to64 );
-    thunk->syscall_thunk.cs    = cs64_sel;
-
-    thunk->unix_thunk.ljmp  = 0xff;
-    thunk->unix_thunk.modrm = 0x2d;
-    thunk->unix_thunk.op    = PtrToUlong( &thunk->unix_thunk.addr );
-    thunk->unix_thunk.addr  = PtrToUlong( unix_call_32to64 );
-    thunk->unix_thunk.cs    = cs64_sel;
+    use_far_call = is_rosetta();
+    init_thunk( &thunk->syscall_thunk, syscall_32to64 );
+    init_thunk( &thunk->unix_thunk, unix_call_32to64 );
 
     NtProtectVirtualMemory( GetCurrentProcess(), (void **)&thunk, &size, PAGE_EXECUTE_READ, &old_prot );
     return STATUS_SUCCESS;
