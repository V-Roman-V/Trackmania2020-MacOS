Subject: winevulkan: Send calls that return nothing in one batch.

A Vulkan call from a PE module has to cross to the Unix side. On macOS each direction
switches GSBASE with a system call, which takes 175 ns under Rosetta, so a crossing
takes about 390 ns of which 350 ns is that switch. wrgsbase isn't available there.
DXVK makes three such calls per draw that only have to happen in order, on top of the
descriptor set allocation, and that adds up to most of the time of its render thread.

Queue those calls per thread on the PE side, with the arrays they point to copied
behind them. Any other call flushes the queue and takes its one crossing along, so
that the order stays the same and only the crossings go away. vkEndCommandBuffer is
such a call, so nothing stays behind in a queue after recording.

An update with a template is queued only if the template's data size is known, which
comes from its create call. Calls are queued for 64-bit programs only, because 32-bit
ones need their structures converted. Debug callbacks that run during a replay call
straight through, since the queue is in use then. WINEVULKAN_NO_BATCH=1 turns this off.

This changes the generated loader_thunks.h and vulkan_thunks.c by hand.

diff --git a/dlls/winevulkan/loader.c b/dlls/winevulkan/loader.c
index 864328e..9951eb3 100644
--- a/dlls/winevulkan/loader.c
+++ b/dlls/winevulkan/loader.c
@@ -331,6 +331,287 @@ static NTSTATUS WINAPI call_vulkan_debug_utils_callback(void *args, ULONG size)
     return NtCallbackReturn(&ret, sizeof(ret), STATUS_SUCCESS);
 }
 
+#ifdef _WIN64
+
+/* Crossing to the Unix side is slow on macOS, where each direction has to switch GSBASE with a
+ * system call, and under Rosetta that alone takes most of the time of a call like vkCmdDraw.
+ * A graphics driver makes several such calls per draw, and most return nothing and only have to
+ * happen in order. So they queue up here, per thread, and share one crossing with the next call
+ * that does return something, such as vkEndCommandBuffer. */
+#define BATCH_SIZE 0x10000
+#define BATCH_MAX_CALL_SIZE 0x1000
+#define TEMPLATE_SLOTS 0x1000
+#define TEMPLATE_PROBES 16
+
+struct batch
+{
+    UINT used;
+    BOOL replaying;
+    BYTE items[BATCH_SIZE];
+};
+
+struct template_slot
+{
+    volatile LONG64 handle;
+    UINT size;
+};
+
+static DWORD batch_tls = TLS_OUT_OF_INDEXES;
+static struct template_slot templates[TEMPLATE_SLOTS];
+
+static void batch_init(void)
+{
+    if (!GetEnvironmentVariableW( L"WINEVULKAN_NO_BATCH", NULL, 0 )) batch_tls = TlsAlloc();
+}
+
+static struct batch *get_batch(void)
+{
+    struct batch *batch = TlsGetValue( batch_tls );
+
+    if (!batch && (batch = malloc( sizeof(*batch) )))
+    {
+        batch->used = 0;
+        batch->replaying = FALSE;
+        TlsSetValue( batch_tls, batch );
+    }
+    return batch;
+}
+
+static NTSTATUS batch_flush( struct batch *batch )
+{
+    struct vk_batch_params params = {batch->items, batch->used};
+    NTSTATUS status;
+
+    /* A debug callback can run during the replay and make calls of its own. */
+    batch->replaying = TRUE;
+    status = WINE_UNIX_CALL( unix_vk_batch, &params );
+    batch->replaying = FALSE;
+    batch->used = 0;
+    return status;
+}
+
+static void *batch_reserve( struct batch *batch, unsigned int code, unsigned int size )
+{
+    struct vk_batch_item *item;
+
+    size = (size + 7) & ~7;
+    if (batch->used + sizeof(*item) + size > BATCH_SIZE) batch_flush( batch );
+    item = (struct vk_batch_item *)(batch->items + batch->used);
+    item->code = code;
+    item->size = size;
+    batch->used += sizeof(*item) + size;
+    return item + 1;
+}
+
+/* Copies an array behind the parameters and points at the copy. */
+static void batch_copy( const void **array, BYTE **pos, unsigned int size )
+{
+    if (!*array) return;
+    *array = memcpy( *pos, *array, size );
+    *pos += size;
+}
+
+static UINT descriptor_size( VkDescriptorType type )
+{
+    switch (type)
+    {
+    case VK_DESCRIPTOR_TYPE_SAMPLER:
+    case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+    case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+    case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+    case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+        return sizeof(VkDescriptorImageInfo);
+    case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+    case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+    case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+    case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+        return sizeof(VkDescriptorBufferInfo);
+    case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+    case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+        return sizeof(VkBufferView);
+    default:
+        return 0;
+    }
+}
+
+static struct template_slot *template_slot( LONG64 handle, unsigned int probe )
+{
+    return &templates[(((ULONG64)handle * 0x9e3779b97f4a7c15ull >> 40) + probe) % TEMPLATE_SLOTS];
+}
+
+/* The data of vkUpdateDescriptorSetWithTemplate has no size of its own, only the template
+ * tells how much to copy. A template we don't know just doesn't get batched. */
+static void remember_template( const VkDescriptorUpdateTemplateCreateInfo *info, VkDescriptorUpdateTemplate handle )
+{
+    UINT i, probe, size = 0;
+
+    for (i = 0; i < info->descriptorUpdateEntryCount; i++)
+    {
+        const VkDescriptorUpdateTemplateEntry *entry = &info->pDescriptorUpdateEntries[i];
+        UINT descriptor = descriptor_size( entry->descriptorType );
+
+        if (!descriptor || !entry->descriptorCount) return;
+        size = max( size, entry->offset + entry->stride * (entry->descriptorCount - 1) + descriptor );
+    }
+    for (probe = 0; probe < TEMPLATE_PROBES; probe++)
+    {
+        struct template_slot *slot = template_slot( (LONG64)handle, probe );
+        LONG64 old = InterlockedCompareExchange64( &slot->handle, (LONG64)handle, 0 );
+
+        if (!old || old == (LONG64)handle)
+        {
+            /* A reused handle can only be looked up after its create call has returned. */
+            slot->size = size;
+            return;
+        }
+    }
+}
+
+static UINT template_size( VkDescriptorUpdateTemplate handle )
+{
+    unsigned int probe;
+
+    for (probe = 0; probe < TEMPLATE_PROBES; probe++)
+    {
+        struct template_slot *slot = template_slot( (LONG64)handle, probe );
+
+        if (slot->handle == (LONG64)handle) return slot->size;
+        if (!slot->handle) break;
+    }
+    return 0;
+}
+
+/* Queues a call if it can wait, and returns whether it did. */
+static BOOL batch_call( struct batch *batch, unsigned int code, void *params, unsigned int size )
+{
+    unsigned int extra;
+    BYTE *pos;
+
+    switch (code)
+    {
+    case unix_vkCmdBindIndexBuffer:
+    case unix_vkCmdBindPipeline:
+    case unix_vkCmdDispatch:
+    case unix_vkCmdDraw:
+    case unix_vkCmdDrawIndexed:
+    case unix_vkCmdSetDepthBias:
+    case unix_vkCmdSetStencilReference:
+        memcpy( batch_reserve( batch, code, size ), params, size );
+        return TRUE;
+
+    case unix_vkCmdBindDescriptorSets:
+    {
+        struct vkCmdBindDescriptorSets_params *call = params, *copy;
+        unsigned int sets = call->descriptorSetCount * sizeof(VkDescriptorSet);
+        unsigned int offsets = call->dynamicOffsetCount * sizeof(uint32_t);
+
+        if ((extra = sets + offsets) > BATCH_MAX_CALL_SIZE) return FALSE;
+        copy = batch_reserve( batch, code, size + extra );
+        *copy = *call;
+        pos = (BYTE *)(copy + 1);
+        batch_copy( (const void **)&copy->pDescriptorSets, &pos, sets );
+        batch_copy( (const void **)&copy->pDynamicOffsets, &pos, offsets );
+        return TRUE;
+    }
+
+    case unix_vkCmdBindVertexBuffers2EXT:
+    {
+        struct vkCmdBindVertexBuffers2EXT_params *call = params, *copy;
+        unsigned int array = call->bindingCount * sizeof(UINT64);
+
+        if ((extra = 4 * array) > BATCH_MAX_CALL_SIZE) return FALSE;
+        copy = batch_reserve( batch, code, size + extra );
+        *copy = *call;
+        pos = (BYTE *)(copy + 1);
+        batch_copy( (const void **)&copy->pBuffers, &pos, array );
+        batch_copy( (const void **)&copy->pOffsets, &pos, array );
+        batch_copy( (const void **)&copy->pSizes, &pos, array );
+        batch_copy( (const void **)&copy->pStrides, &pos, array );
+        return TRUE;
+    }
+
+    case unix_vkCmdSetBlendConstants:
+    {
+        struct vkCmdSetBlendConstants_params *call = params, *copy;
+
+        copy = batch_reserve( batch, code, size + 4 * sizeof(float) );
+        *copy = *call;
+        pos = (BYTE *)(copy + 1);
+        batch_copy( (const void **)&copy->blendConstants, &pos, 4 * sizeof(float) );
+        return TRUE;
+    }
+
+    case unix_vkCmdSetScissor:
+    {
+        struct vkCmdSetScissor_params *call = params, *copy;
+
+        if ((extra = call->scissorCount * sizeof(VkRect2D)) > BATCH_MAX_CALL_SIZE) return FALSE;
+        copy = batch_reserve( batch, code, size + extra );
+        *copy = *call;
+        pos = (BYTE *)(copy + 1);
+        batch_copy( (const void **)&copy->pScissors, &pos, extra );
+        return TRUE;
+    }
+
+    case unix_vkCmdSetViewport:
+    {
+        struct vkCmdSetViewport_params *call = params, *copy;
+
+        if ((extra = call->viewportCount * sizeof(VkViewport)) > BATCH_MAX_CALL_SIZE) return FALSE;
+        copy = batch_reserve( batch, code, size + extra );
+        *copy = *call;
+        pos = (BYTE *)(copy + 1);
+        batch_copy( (const void **)&copy->pViewports, &pos, extra );
+        return TRUE;
+    }
+
+    case unix_vkUpdateDescriptorSetWithTemplate:
+    {
+        struct vkUpdateDescriptorSetWithTemplate_params *call = params, *copy;
+
+        if (!(extra = template_size( call->descriptorUpdateTemplate )) || extra > BATCH_MAX_CALL_SIZE) return FALSE;
+        copy = batch_reserve( batch, code, size + extra );
+        *copy = *call;
+        pos = (BYTE *)(copy + 1);
+        batch_copy( &copy->pData, &pos, extra );
+        return TRUE;
+    }
+
+    default:
+        return FALSE;
+    }
+}
+
+NTSTATUS vk_unix_call( unsigned int code, void *params, unsigned int size )
+{
+    struct batch *batch;
+    NTSTATUS status;
+
+    if (batch_tls == TLS_OUT_OF_INDEXES || !(batch = get_batch()) || batch->replaying)
+        return WINE_UNIX_CALL( code, params );
+    if (batch_call( batch, code, params, size )) return STATUS_SUCCESS;
+
+    if (batch->used)
+    {
+        void **indirect = batch_reserve( batch, code, sizeof(*indirect) );
+
+        ((struct vk_batch_item *)indirect - 1)->size = 0;
+        *indirect = params;
+        status = batch_flush( batch );
+    }
+    else status = WINE_UNIX_CALL( code, params );
+
+    if (code == unix_vkCreateDescriptorUpdateTemplate || code == unix_vkCreateDescriptorUpdateTemplateKHR)
+    {
+        struct vkCreateDescriptorUpdateTemplate_params *call = params;
+
+        if (call->result == VK_SUCCESS) remember_template( call->pCreateInfo, *call->pDescriptorUpdateTemplate );
+    }
+    return status;
+}
+
+#endif /* _WIN64 */
+
 static BOOL WINAPI wine_vk_init(INIT_ONCE *once, void *param, void **context)
 {
     struct init_params params =
@@ -772,6 +1053,9 @@ BOOL WINAPI DllMain(HINSTANCE hinst, DWORD reason, void *reserved)
         case DLL_PROCESS_ATTACH:
             hinstance = hinst;
             DisableThreadLibraryCalls(hinst);
+#ifdef _WIN64
+            batch_init();
+#endif
             break;
     }
     return TRUE;
diff --git a/dlls/winevulkan/loader_thunks.h b/dlls/winevulkan/loader_thunks.h
index 90f24c3..973efc8 100644
--- a/dlls/winevulkan/loader_thunks.h
+++ b/dlls/winevulkan/loader_thunks.h
@@ -764,6 +764,7 @@ enum unix_call
     unix_vkWriteMicromapsPropertiesEXT,
     unix_vkWriteResourceDescriptorsEXT,
     unix_vkWriteSamplerDescriptorsEXT,
+    unix_vk_batch,
     unix_count,
 };
 
diff --git a/dlls/winevulkan/vulkan.c b/dlls/winevulkan/vulkan.c
index 2dac08a..bdb0d8d 100644
--- a/dlls/winevulkan/vulkan.c
+++ b/dlls/winevulkan/vulkan.c
@@ -984,6 +984,24 @@ static NTSTATUS is_available_device_function(VkDevice handle, const char *name)
     return !!vk_funcs->p_vkGetDeviceProcAddr(device->host.device, name);
 }
 
+/* Runs the calls that the PE side queued up, see vk_unix_call(). */
+NTSTATUS vk_batch(void *args)
+{
+    const struct vk_batch_params *params = args;
+    const char *pos = params->items, *end = pos + params->size;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    while (pos < end)
+    {
+        const struct vk_batch_item *item = (const struct vk_batch_item *)pos;
+        void *call = (void *)(item + 1);
+
+        status = __wine_unix_call_funcs[item->code](item->size ? call : *(void **)call);
+        pos = (const char *)call + (item->size ? item->size : sizeof(void *));
+    }
+    return status;
+}
+
 #ifdef _WIN64
 
 NTSTATUS vk_is_available_instance_function(void *arg)
diff --git a/dlls/winevulkan/vulkan_loader.h b/dlls/winevulkan/vulkan_loader.h
index 9b05806..9e1e271 100644
--- a/dlls/winevulkan/vulkan_loader.h
+++ b/dlls/winevulkan/vulkan_loader.h
@@ -143,7 +143,26 @@ struct is_available_device_function_params
     const char *name;
 };
 
+/* One item of a batch of Unix calls. Its parameters follow, 8-byte aligned. A size of 0 means
+ * that a pointer to them follows instead, for a call whose results are read afterwards. */
+struct vk_batch_item
+{
+    UINT code;
+    UINT size;
+};
+
+struct vk_batch_params
+{
+    const void *items;
+    UINT size;
+};
+
+#ifdef _WIN64
+NTSTATUS vk_unix_call( unsigned int code, void *params, unsigned int size );
+#define UNIX_CALL(code, params) vk_unix_call( unix_ ## code, params, sizeof(*(params)) )
+#else
 #define UNIX_CALL(code, params) WINE_UNIX_CALL(unix_ ## code, params)
+#endif
 #define UNIX_CALL_CHECKED(code, params)                           \
     do {                                                          \
         NTSTATUS status = UNIX_CALL(code, params);                \
diff --git a/dlls/winevulkan/vulkan_private.h b/dlls/winevulkan/vulkan_private.h
index bc8fe30..835da6e 100644
--- a/dlls/winevulkan/vulkan_private.h
+++ b/dlls/winevulkan/vulkan_private.h
@@ -56,6 +56,7 @@ BOOL wine_vk_is_type_wrapped(VkObjectType type);
 NTSTATUS init_vulkan(void *args);
 NTSTATUS wow64_init_vulkan(void *args);
 
+NTSTATUS vk_batch(void *args);
 NTSTATUS vk_is_available_instance_function(void *arg);
 NTSTATUS vk_is_available_device_function(void *arg);
 NTSTATUS vk_is_available_instance_function32(void *arg);
diff --git a/dlls/winevulkan/vulkan_thunks.c b/dlls/winevulkan/vulkan_thunks.c
index 44253a6..8e6caba 100644
--- a/dlls/winevulkan/vulkan_thunks.c
+++ b/dlls/winevulkan/vulkan_thunks.c
@@ -72420,6 +72420,7 @@ const unixlib_entry_t __wine_unix_call_funcs[] =
     thunk64_vkWriteMicromapsPropertiesEXT,
     (void *)thunk64_vkWriteResourceDescriptorsEXT,
     (void *)thunk64_vkWriteSamplerDescriptorsEXT,
+    vk_batch,
 };
 C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == unix_count);
 
@@ -73176,5 +73177,6 @@ const unixlib_entry_t __wine_unix_call_funcs[] =
     thunk32_vkWriteMicromapsPropertiesEXT,
     (void *)thunk32_vkWriteResourceDescriptorsEXT,
